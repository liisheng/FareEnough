# FareEnough backend configuration (SRS OPS-02)
# Copy to .env and adjust. Never commit .env.

APP_MODE=demo
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=.runtime/fareenough.sqlite

# AI mode: "replay" until a live provider is configured
AI_MODE=replay
MODEL_PROVIDER=deepseek
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# MODEL_API_KEY=server-only-secret
MODEL_CALL_TIMEOUT_MS=60000
RUN_TIMEOUT_MS=240000
MAX_MODEL_CALLS_PER_RUN=12
MAX_INPUT_TOKENS_PER_RUN=100000
MAX_OUTPUT_TOKENS_PER_RUN=24000
MAX_MODEL_CALLS_PER_SESSION=60
# MODEL_SESSION_BUDGET_USD=set before paid live runs
SESSION_SECRET=change-me-for-local-dev
ENABLE_DEMO_RESET=true
