# FareEnough backend configuration (SRS OPS-02)
# Copy to backend/.env and adjust. Never commit .env.

APP_MODE=demo
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=.runtime/fareenough.sqlite

# AI mode: set "live" to enable explicitly requested ADP runs; replay remains available.
AI_MODE=replay
MODEL_PROVIDER=deepseek
# Select the supplied policy explicitly; historical replay keeps its original profile.
REVIEW_POLICY_PROFILE=ryde-v2.1
# For ADP set MODEL_PROVIDER=adp and configure all three published applications.
ADP_CHAT_URL=https://wss.lke.tencentcloud.com/adp/v2/chat
ADP_RIDER_APP_KEY=""
ADP_DRIVER_APP_KEY=""
ADP_JUDGE_APP_KEY=""
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# MODEL_API_KEY=server-only-secret
MODEL_CALL_TIMEOUT_MS=60000
RUN_TIMEOUT_MS=240000
MAX_MODEL_CALLS_PER_RUN=12
MAX_MODEL_CALLS_PER_SESSION=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180
RUN_RATE_LIMIT_WINDOW_MS=600000
RUN_RATE_LIMIT_MAX_STARTS=6
# Byte/call/time limits are enforced; these are not a provider billing ceiling.
SESSION_SECRET=change-me-for-local-dev
ENABLE_DEMO_RESET=true
