{
  "name": "@fareenough/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FareEnough dispute resolution backend",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
